# Banco de dados (PostgreSQL em produção; ver README para alternativa SQLite local)
DATABASE_URL="postgresql://user:password@localhost:5432/mhzmob_contracts"

# NextAuth
NEXTAUTH_SECRET="gere-com: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Chave de criptografia dos dados de contrato em repouso (32 bytes em base64)
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY="gere-com: openssl rand -base64 32"

# Usuário administrador criado pelo seed inicial (troque a senha no primeiro login)
SEED_ADMIN_EMAIL="admin@mhzmob.com.br"
SEED_ADMIN_PASSWORD="TrocarSenha123!"
